# Supabase project settings (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Finnhub free-tier API key (finnhub.io)
FINNHUB_API_KEY=

# Optional: Upstash Redis REST credentials for the shared symbol cache.
# If left blank, the app falls back to an in-memory cache (fine for local dev,
# not shared across serverless instances in production).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Secret used to authenticate the cron job that refreshes market data.
# Vercel automatically sends this as "Authorization: Bearer <CRON_SECRET>"
# to scheduled functions when this env var is set.
CRON_SECRET=changeme
